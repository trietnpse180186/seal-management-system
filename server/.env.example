# Port
PORT=5000

# MongoDB Connection
MONGO_URI=mongodb+srv://admin:admin123@shm.y6xjk55.mongodb.net/
# OR local: MONGO_URI=mongodb://127.0.0.1:27017/seal-hackathon

# Thêm cấu hình Redis (Ví dụ dùng local Redis)
REDIS_URL=redis://127.0.0.1:6379

# JWT Secret Key
JWT_SECRET=seal_hackathon_secret_key_2026

# Email configuration (SMTP or mock)
# true = không gửi mail thật, chỉ log ra console (dùng khi dev/test)
EMAIL_SERVICE_MOCK=false
EMAIL_HOST=sandbox.smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=your_smtp_username
EMAIL_PASS=your_smtp_password
EMAIL_FROM=seal-hackathon@domain.com
# Mailjet API (ưu tiên cao nhất nếu set cả 2 key — thay thế SMTP/Resend/SendGrid/Brevo)
# Đăng ký tại https://app.mailjet.com → Account Settings → API Key Management
# MJ_APIKEY_PUBLIC=your_mailjet_api_key
# MJ_APIKEY_PRIVATE=your_mailjet_secret_key

# GitHub API configuration (with Mock option for offline/testing)
# Set to false to use real GitHub API with organization
GITHUB_SERVICE_MOCK=true
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_YOUR_PERSONAL_ACCESS_TOKEN_HERE
GITHUB_ORGANIZATION=seal-hackathon

# Gemini AI configuration (with Mock option for offline/testing)
# Set to false to use Google Gemini AI
GEMINI_SERVICE_MOCK=true
GEMINI_API_KEY=AIzaSy_YOUR_GEMINI_API_KEY_HERE

# GitHub OAuth App Credentials for Login
GITHUB_CLIENT_ID=Ov23liz8uHIFRtgdwDwE
GITHUB_CLIENT_SECRET=eb9a526811f9bc9b70b5ec1042974aa5e3c55df9

# n8n Workflow Integration
# Set N8N_WEBHOOK_URL to route AI analysis through n8n. If unset or failing, system degrades gracefully to local Gemini/Mock.
N8N_WEBHOOK_URL=
# Key used to secure callback requests from n8n to backend (/api/ai-analyses/n8n-callback)
CLIENT_URL=http://localhost:5173

# Google Drive exam access (share đề theo email đã đăng ký — bắt buộc)
# Tải JSON key từ GCP → đặt tại server/secrets/google-drive-sa.json (không commit)
GOOGLE_DRIVE_SERVICE_ACCOUNT_PATH=./secrets/google-drive-sa.json

# Lexatek Simulator API Service Key
SERVICE_API_KEY=YOUR_LEXATEK_SERVICE_API_KEY_HERE
